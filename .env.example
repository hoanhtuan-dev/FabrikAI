APP_NAME="FabrikAI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SOCKET=/tmp/mysql.sock   # Hostinger/shared hosting: dùng Unix socket thay vì TCP để tránh lỗi 2002 "Operation not permitted" từ PHP worker

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Studio: máy chủ này CÓ chạy `php artisan queue:work` nền hay không? (xem config/studio.php)
# false = dev / máy chủ chưa có worker: request poll tự xử lý inline — request có thể kéo dài vài phút
#         vì các service phải sleep() chờ provider (N11/M13).
# true  = PRODUCTION: request chỉ enqueue rồi trả về ngay, worker nền mới sleep(). BẮT BUỘC chạy kèm
#         `php artisan queue:work --timeout=900 --tries=1`, nếu không generation sẽ không bao giờ chạy.
STUDIO_QUEUE_WORKER=false

# ── Seeder: mật khẩu tài khoản QUẢN TRỊ ──────────────────────────────────────────────
# Repo này là PUBLIC nên mật khẩu hardcode trong seeder coi như đã bị lộ. Ở production, seeder
# BẮT BUỘC đọc mật khẩu từ 2 biến dưới; thiếu là seeder DỪNG (fail-closed), không tạo tài khoản.
# Ở dev/test có giá trị mặc định cho tiện. Seeder KHÔNG BAO GIỜ ghi đè mật khẩu đã tồn tại.
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_DATA=false   # production: chỉ đặt true nếu thật sự muốn seed dữ liệu demo storefront

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

## ------------------------------------------------------------------------
## PRODUCTION HARDENING (set these on the production server, NOT locally)
## ------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# SESSION_SECURE_COOKIE=true        # only when serving over HTTPS
# SESSION_ENCRYPT=true
# SESSION_HTTP_ONLY=true
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_DATABASE=<db>
# DB_USERNAME=<user>
# DB_PASSWORD=<pass>
# MAIL_MAILER=smtp                  # or e.g. 'mailgun' / 'smtp' with host/username/password
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# STUDIO_QUEUE_WORKER=true           # PHẢI true ở production, và PHẢI chạy kèm:
#                                    #   php artisan queue:work --timeout=900 --tries=1
#                                    # (supervisor/systemd giữ cho worker sống lại sau crash/reboot)
# LOG_CHANNEL=stack
# LOG_LEVEL=error
# ---- FabrikAI Studio (AI) ----
# Khi để trống, Studio dùng stub (mô phỏng) để luồng chạy được.
# GEMINI_API_KEY=
# FAL_KEY=
# STUDIO_CRON_TOKEN=            # token cho /api/cron/tick (cron ngoài); sinh bằng: php -r "echo bin2hex(random_bytes(32));"
# REPLICATE_API_TOKEN=
# WAN_API_KEY=
# GOOGLE_VEO_KEY=
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=   # Wan / Qwen image (Alibaba)
# STUDIO_IMAGE_PROVIDER=qwen   # qwen | flux | wan | gemini | slug custom
# STUDIO_PROVIDER_PRIORITY=qwen,custom,flux,gemini   # luồng ưu tiên provider (đổi được trong Cài đặt)
# STUDIO_IMAGE_CREDITS=1
# STUDIO_VIDEO_CREDITS=10
#
# Custom provider qua trang Cài đặt → Custom Providers. Ví dụ CKEY (https://ckey.vn/docs):
#   slug: ckey · protocol: openai · base_url: https://api.xah.io/v1 · key: Bearer CKEY key
#   chat: {base}/chat/completions · ảnh: {base}/images/generations (model dạng user/qwen-image-…)